---
import Icon from './Icon.astro';
import { achievements } from '../data/achievements';
---
<section class="bg-quiet py-16 mobile:py-11" id="prestasi" aria-labelledby="achievement-title">
  <div class="container mx-auto w-[min(1232px,calc(100%-112px))] compact:w-[calc(100%-64px)] mobile:w-[calc(100%-40px)]" data-achievement-showcase>
    <header class="mb-9 [&>p]:mt-3.5 [&>p]:max-w-[60ch] [&>p]:text-muted mobile:mb-6.5">
      <h2 class="font-editorial font-medium leading-[1.12] tracking-[-.035em] text-balance text-[clamp(2.15rem,3.4vw,3.1rem)]" id="achievement-title">Prestasi yang menginspirasi.</h2>
      <p>Lima cerita mahasiswa SiberMu berkarya di tingkat nasional dan internasional.</p>
    </header>
    <div class="grid grid-cols-1 items-start gap-12 ready:grid-cols-[minmax(0,1fr)_minmax(260px,.42fr)] compact:gap-7 tablet:ready:grid-cols-1">
      <div class="min-w-0 ready:[touch-action:pan-y_pinch-zoom]" data-achievement-stage>
        <div class="grid min-w-0 gap-9 ready:gap-0">
          {achievements.map(item => (
            <article class="
              grid min-w-0 grid-cols-[minmax(0,.8fr)_minmax(0,1fr)] items-start gap-7 ready:invisible
              ready:pointer-events-none ready:[grid-area:1/1] ready:[&.is-active]:visible
              ready:[&.is-active]:pointer-events-auto compact:grid-cols-[minmax(0,.75fr)_minmax(0,1fr)]
              compact:gap-5.5 tablet:grid-cols-[minmax(0,.7fr)_minmax(0,1fr)] tablet:gap-8 mobile:grid-cols-1
              mobile:gap-5.5
            " id={`prestasi-${item.id}`} data-achievement-panel aria-labelledby={`award-${item.id}`} tabindex="-1">
              <figure class="min-w-0">
                <a class="flex aspect-4/5 items-center justify-center rounded bg-paper tablet:max-w-[320px] mobile:aspect-auto mobile:h-80 mobile:max-w-none" href={item.source} target="_blank" rel="noopener noreferrer" aria-label={`Lihat dokumentasi ${item.students}`}>
                  <img class="h-full w-full rounded object-contain mobile:w-auto mobile:max-w-full" src={item.image} srcset={`${item.imageSmall} ${item.id === 'midbrain' ? 800 : 640}w, ${item.image} ${item.id === 'midbrain' ? 1140 : 800}w`} sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 900px) 320px, 358px" width={item.id === 'midbrain' ? 1140 : 800} height={item.id === 'midbrain' ? 500 : 1000} loading="lazy" decoding="async" alt={item.imageAlt} draggable="false" />
                </a>
                <figcaption class="mt-2.5 text-[.75rem] leading-normal text-muted">{item.imageCredit}</figcaption>
              </figure>
              <div class="min-w-0">
                <h3 class="font-editorial text-[clamp(1.8rem,2.5vw,2.4rem)] leading-[1.14] font-medium tracking-tight text-balance wrap-break-word mobile:text-[2rem]" id={`award-${item.id}`}>{item.title}</h3>
                <p class="mt-3 text-[.875rem] font-semibold text-blue">{item.level}<span aria-hidden="true"> · </span>{item.year}</p>
                <p class="achievement-names mt-6 text-[1.05rem] leading-[1.45] font-semibold text-navy mobile:mt-5">{item.students}</p>
                <p class="mt-1.5 text-[.875rem] text-muted">{item.program}</p>
                <p class="mt-5.5 text-[.94rem] leading-[1.55] font-medium text-ink mobile:mt-4.5">{item.competition}</p>
                <p class="mt-3 text-[.94rem] leading-[1.65] text-muted">{item.description}</p>
                <a class="inline-flex min-h-11 items-center gap-3.25 font-semibold hover:underline mt-4 text-[.875rem] text-blue" href={item.source} target="_blank" rel="noopener noreferrer">{item.sourceLabel}<Icon name="diagonal" size={17}/></a>
                <p class="mt-2 text-[.8125rem] text-muted">{item.publication}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-6 flex items-center justify-between gap-5 border-t border-line pt-4.5 mobile:mt-5" data-achievement-controls hidden>
          <span class="text-[.875rem] text-muted tabular-nums" data-achievement-counter aria-hidden="true">1 dari {achievements.length}</span>
          <div class="flex gap-2">
            <button class="flex size-11 items-center justify-center rounded-md border border-[#b8c9db] bg-transparent p-0 text-navy hover:border-navy hover:bg-sky" type="button" data-achievement-previous aria-label="Prestasi sebelumnya"><Icon class="rotate-180" size={20}/></button>
            <button class="flex size-11 items-center justify-center rounded-md border border-[#b8c9db] bg-transparent p-0 text-navy hover:border-navy hover:bg-sky" type="button" data-achievement-next aria-label="Prestasi berikutnya"><Icon size={20}/></button>
          </div>
        </div>
      </div>
      <div class="border-t border-[#b8c9db] tablet:grid tablet:grid-cols-2 tablet:gap-x-5 mobile:hidden" data-achievement-choices role="group" aria-label="Pilih cerita prestasi" hidden>
        {achievements.map((item, index) => (
          <button class="
            flex w-full items-center justify-between gap-4.5 border-0 border-b border-line
            bg-transparent px-4 py-4.75 text-left text-ink hover:bg-paper aria-pressed:bg-sky aria-pressed:text-navy
            aria-pressed:hover:bg-sky focus-visible:relative focus-visible:outline-offset-[-3px] [&>svg]:opacity-0
            aria-pressed:[&>svg]:opacity-100
          " type="button" data-achievement-choice aria-controls={`prestasi-${item.id}`} aria-pressed={index === 0 ? 'true' : 'false'}>
            <span class="
              [&>strong]:block [&>strong]:text-[.96rem] [&>strong]:leading-[1.45]
              [&>strong]:font-semibold [&>span]:mt-1.25 [&>span]:block [&>span]:text-[.875rem] [&>span]:leading-normal
              [&>span]:text-muted [&>small]:mt-1.75 [&>small]:block [&>small]:text-[.8125rem] [&>small]:text-muted
            "><strong>{item.shortTitle}</strong><span>{item.shortNames}</span><small>{item.level} · {item.year}</small></span>
            <Icon size={18}/>
          </button>
        ))}
      </div>
    </div>
    <p class="sr-only" data-achievement-status role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>
<script>
  import { initAchievementShowcase } from '../scripts/achievement-showcase';
  document.querySelectorAll<HTMLElement>('[data-achievement-showcase]').forEach(initAchievementShowcase);
</script>
