---
import Icon from './Icon.astro';
import { activities } from '../data/content';
---
<section class="container section activities-section" id="kegiatan" aria-labelledby="activities-title">
  <div class="activities-heading">
    <h2 id="activities-title">Kehidupan kampus,<br />dalam kegiatan.</h2>
    <p>Dari persiapan karier hingga pengabdian dan kajian. Jelajahi dokumentasi kegiatan serta program kampus, lengkap dengan tanggal atau tahun sumbernya.</p>
  </div>
  <div class="activity-controls" role="group" aria-label="Filter kegiatan terdokumentasi">
    <button type="button" data-filter="all" aria-pressed="true">Semua kegiatan</button>
    <button type="button" data-filter="mahasiswa" aria-pressed="false">Kemahasiswaan</button>
    <button type="button" data-filter="aik" aria-pressed="false">AIK</button>
    <span id="activity-count" role="status" aria-live="polite">{activities.length} dokumentasi</span>
  </div>
  <div class="activity-list">
    {activities.map(item => (
      <article class="activity-entry" data-category={item.category}>
        <p class="activity-period">{item.timing}<span>{item.label}</span></p>
        <details class="activity-disclosure">
          <summary><span><span class="activity-title">{item.title}</span><span class="activity-description">{item.type}</span></span><Icon name="plus" size={19} class="disclosure-icon"/></summary>
          <div><p>{item.description}</p><a class="text-link" href={item.source} target="_blank" rel="noopener noreferrer">{item.sourceLabel} <Icon name="diagonal" size={16}/></a></div>
        </details>
      </article>
    ))}
  </div>
  <noscript><p class="draft-note">Semua dokumentasi ditampilkan. Aktifkan JavaScript untuk memakai filter.</p></noscript>
</section>
<script>
  const section = document.querySelector('#kegiatan');
  const controls = section?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [];
  const items = section?.querySelectorAll<HTMLElement>('[data-category]') ?? [];
  const count = section?.querySelector('#activity-count');

  function selectCategory(category: string) {
    if (!['all', 'mahasiswa', 'aik'].includes(category)) return;
    controls.forEach(control => control.setAttribute('aria-pressed', String(control.dataset.filter === category)));
    let visible = 0;
    items.forEach(item => {
      const show = category === 'all' || item.dataset.category === category;
      item.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = `${visible} dokumentasi`;
  }

  controls.forEach(button => button.addEventListener('click', () => selectCategory(button.dataset.filter ?? 'all')));

  // Apply the filter before the native anchor scroll, after the list changes height.
  // General activity links restore all entries after a visit through the AIK CTA.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#kegiatan"]').forEach(link => {
    link.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      selectCategory(link.dataset.activityFilter ?? 'all');
    });
  });
</script>
