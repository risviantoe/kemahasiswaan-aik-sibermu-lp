---
import Icon from './Icon.astro';
import { sources } from '../data/content';
const principles = [
  { title: 'Pembinaan', description: 'Memperdalam pemahaman melalui kajian dan pembelajaran keislaman.' },
  { title: 'Pengamalan', description: 'Menghubungkan nilai Islam dengan tindakan dan kepedulian sehari-hari.' },
  { title: 'Kemuhammadiyahan', description: 'Mengenal semangat Islam berkemajuan: iman, ilmu, dan amal.' },
];
---
<section class="aik-banner" id="aik" aria-labelledby="aik-title">
  <div class="aik-stage">
    <figure class="aik-banner-image">
      <img src="/images/aik-campus-v2.webp" srcset="/images/aik-campus-v2-small.webp 720w, /images/aik-campus-v2.webp 1440w" sizes="(max-width: 700px) 100vw, (max-width: 1400px) 60vw, 840px" width="1440" height="960" loading="lazy" decoding="async" alt="Ilustrasi AI mahasiswi beralmamater navy dan hijab krem memegang Al-Quran di lingkungan kampus imajinatif" />
      <figcaption>Ilustrasi AI · Tokoh & bangunan fiktif</figcaption>
    </figure>
    <div class="container aik-banner-inner">
      <div class="aik-banner-copy">
        <h2 id="aik-title">Teguh dalam nilai.</h2>
        <p class="aik-name">Al-Islam & Kemuhammadiyahan</p>
        <p>Ilmu memberi kemampuan.<br />Nilai memberi arah.</p>
        <div class="aik-actions">
          <a href="#kegiatan" data-activity-filter="aik" class="button">Jelajahi kegiatan AIK <Icon size={18}/></a>
          <a href={sources.values} target="_blank" rel="noopener noreferrer" class="text-link">Kenali Islam Berkemajuan <Icon name="diagonal" size={16}/></a>
        </div>
      </div>
    </div>
  </div>
  <dl class="container aik-principles">
    {principles.map(item => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
  </dl>
</section>
