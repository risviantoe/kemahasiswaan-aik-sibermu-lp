---
import Icon from './Icon.astro';
import { communities, communityInquiry } from '../data/content';
---
<section class="container section community-section" id="komunitas" aria-labelledby="community-title">
  <div class="community-editorial">
    <div class="community-invitation">
      <h2 id="community-title">Temukan lingkunganmu.</h2>
      <p>Jelajahi komunitas mahasiswa SiberMu di bidang bahasa, bisnis, dan karya digital. Cari tahu kegiatan serta sumber informasinya.</p>
      <figure class="community-photo">
        <img src="/images/community-campus-v2.webp" srcset="/images/community-campus-v2-small.webp 720w, /images/community-campus-v2.webp 1440w" sizes="(max-width: 700px) calc(100vw - 40px), 46vw" width="1440" height="960" loading="lazy" decoding="async" alt="Ilustrasi AI empat mahasiswa beralmamater navy berdiskusi bersama di halaman kampus imajinatif" />
        <figcaption>Ilustrasi AI · Tokoh & bangunan fiktif</figcaption>
      </figure>
    </div>
    <div class="community-directory">
      {communities.map(item => (
        <details class="community-row">
          <summary>
            <span><span class="community-name">{item.title}</span><span class="community-description">{item.description}</span></span>
            <Icon name="plus" size={19} class="disclosure-icon"/>
          </summary>
          <div class="community-evidence">
            <p class="archive-label">{item.status}</p>
            <p>{item.detail}</p>
            <a class="text-link" href={item.source} target="_blank" rel="noopener noreferrer">{item.sourceLabel} <Icon name="diagonal" size={16}/></a>
          </div>
        </details>
      ))}
      <p class="community-archive-note">Profil UKM merujuk laporan 2023. Status aktif, kontak pengurus, dan pendaftaran terbaru perlu dikonfirmasi ke kampus.</p>
      <a class="text-link community-inquiry" href={communityInquiry} target="_blank" rel="noopener noreferrer">Tanyakan informasi UKM <Icon name="diagonal" size={16}/></a>
    </div>
  </div>
</section>
