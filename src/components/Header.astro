---
import Icon from './Icon.astro';
const links = [['AIK', '#aik'], ['Komunitas', '#komunitas'], ['Prestasi', '#prestasi'], ['Kegiatan', '#kegiatan']];
---
<a class="fixed top-3 left-3 z-100 -translate-y-[200%] bg-navy px-[18px] py-3 text-white focus:translate-y-0" href="#main">Lewati ke konten</a>
<header class="site-header sticky top-0 z-30 border-b border-line bg-paper">
  <div class="
    container mx-auto w-[min(1232px,calc(100%_-_112px))] compact:w-[calc(100%_-_64px)]
    mobile:w-[calc(100%_-_40px)] flex min-h-24 items-center justify-between gap-7
    tablet:min-h-[82px] mobile:min-h-[76px] mobile:gap-3 mobile:py-2.5
  ">
    <a class="flex min-w-0 items-center gap-2.5 text-navy mobile:gap-2" href="#beranda">
      <span class="
        block shrink-0 overflow-hidden [&>img]:h-full [&>img]:w-auto [&>img]:max-w-none h-[52.5px]
        w-[60px] compact:h-[45.5px] compact:w-[52px] mobile:h-[35px] mobile:w-10
      " aria-hidden="true"><img src="/images/sibermu-emblem-official.webp" width="208" height="182" alt="" /></span>
      <span class="
        block min-w-0 [&>strong]:block [&>strong]:font-display [&>strong]:font-bold
        [&>strong]:leading-[1.3] [&>strong]:uppercase [&>small]:block [&>small]:font-normal [&>small]:leading-[1.4]
        [&>strong]:text-[1.2rem] [&>small]:text-[.85rem] [&>small]:text-muted compact:[&>strong]:text-[1.1rem]
        compact:[&>small]:text-[.75rem] mobile:[&>strong]:text-[clamp(.875rem,3.8vw,1rem)]
        mobile:[&>small]:mt-[3px] mobile:[&>small]:text-[.6875rem]
      "><strong>Kemahasiswaan & AIK</strong><small>Universitas Siber Muhammadiyah</small></span>
    </a>
    <button class="menu-toggle hidden size-11 items-center justify-center rounded-md border border-line bg-transparent tablet:flex mobile:shrink-0" type="button" aria-label="Buka navigasi" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" /></button>
    <nav class="
      flex items-center gap-[29px] text-[.875rem] font-medium compact:gap-[18px] tablet:absolute tablet:inset-x-0
      tablet:top-full tablet:hidden tablet:flex-col tablet:items-stretch tablet:gap-0 tablet:border-b
      tablet:border-line tablet:bg-paper tablet:px-8 tablet:pt-4 tablet:pb-6 tablet:[&.is-open]:flex
      mobile:text-[1rem] [&>a]:py-3 [&>a:hover]:text-blue [&>a[aria-current=location]]:font-semibold
      [&>a[aria-current=location]]:text-navy
    " id="main-nav" aria-label="Navigasi utama">
      {links.map(([label, href]) => <a class="aria-[current=location]:underline aria-[current=location]:decoration-2 aria-[current=location]:underline-offset-8" href={href}>{label}</a>)}
      <a class="
        ml-1 flex items-center gap-4 rounded-md border border-[#b8c9db] px-[18px]
        aria-[current=location]:border-navy aria-[current=location]:bg-sky tablet:mx-0 tablet:mt-2
        tablet:justify-between
      " href="#layanan">Layanan mahasiswa <Icon name="diagonal" size={17} /></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Buka navigasi'); nav?.classList.remove('is-open'); }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup navigasi' : 'Buka navigasi');
    nav?.classList.toggle('is-open', open);
  });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  window.matchMedia('(min-width: 901px)').addEventListener('change', closeMenu);

  const header = document.querySelector<HTMLElement>('.site-header');
  const sectionLinks = Array.from(nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []);
  const sections = sectionLinks.flatMap(link => {
    const section = document.getElementById(link.hash.slice(1));
    return section ? [{ link, section }] : [];
  });
  let activeId = '';
  let frame = 0;
  let navigating = false;
  let settleTimer: ReturnType<typeof setTimeout>;

  function setActiveSection(id: string) {
    if (id === activeId) return;
    activeId = id;
    for (const { link, section } of sections) {
      if (section.id === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  function updateActiveSection() {
    frame = 0;
    if (navigating) return;
    // Activate just below the sticky header, including native anchor offsets.
    const readingLine = (header?.getBoundingClientRect().bottom ?? 0) + 32;
    let id = '';
    for (const { section } of sections) {
      if (section.getBoundingClientRect().top <= readingLine) id = section.id;
    }
    // The final section may be too short to reach the reading line.
    if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      id = sections.at(-1)?.section.id ?? id;
    }
    setActiveSection(id);
  }

  function queueUpdate() {
    if (!frame) frame = requestAnimationFrame(updateActiveSection);
  }

  function finishNavigation() {
    clearTimeout(settleTimer);
    navigating = false;
    queueUpdate();
  }

  function waitForScrollToSettle() {
    clearTimeout(settleTimer);
    settleTimer = setTimeout(finishNavigation, 180);
  }

  for (const { link, section } of sections) {
    link.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      setActiveSection(section.id);
      navigating = true;
      waitForScrollToSettle();
    });
  }
  window.addEventListener('scroll', () => {
    if (navigating) waitForScrollToSettle();
    else queueUpdate();
  }, { passive: true });
  window.addEventListener('wheel', finishNavigation, { passive: true });
  window.addEventListener('touchstart', finishNavigation, { passive: true });
  window.addEventListener('resize', queueUpdate);
  window.addEventListener('pageshow', finishNavigation);
  window.addEventListener('hashchange', queueUpdate);
  // Disclosures, images and fonts can shift section boundaries without scrolling.
  const layoutObserver = new ResizeObserver(queueUpdate);
  layoutObserver.observe(document.body);
  if (header) layoutObserver.observe(header);
  document.fonts.ready.then(queueUpdate);
  queueUpdate();
</script>
